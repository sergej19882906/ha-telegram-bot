# =============================================================================
# HA Telegram Bot — пример конфигурации (.env)
# Скопируйте этот файл в .env и заполните значения:
#   Linux:  cp .env.example .env
#   Windows: copy .env.example .env
# =============================================================================

# --- Telegram ----------------------------------------------------------------
# Токен бота от @BotFather (обязательно)
TELEGRAM_BOT_TOKEN=

# --- Home Assistant ----------------------------------------------------------
# Адрес вашего Home Assistant (обязательно)
HA_BASE_URL=http://localhost:8123

# Long-Lived Access Token (Профиль -> Long-Lived Access Tokens) (обязательно)
HA_ACCESS_TOKEN=

# --- Доступ ------------------------------------------------------------------
# Разрешённые пользователи — Telegram ID через запятую.
# Узнать свой ID: напишите @userinfobot в Telegram.
# ВНИМАНИЕ: если оставить пустым, доступ к боту будет разрешён ВСЕМ!
ALLOWED_USER_IDS=

# Язык по умолчанию для новых пользователей: ru или en
DEFAULT_LANG=ru

# --- Приёмник уведомлений из Home Assistant (опционально) --------------------
# Бот поднимет HTTP-endpoint, куда HA может присылать сообщения через
# rest_command (см. README.md -> "Уведомления из Home Assistant").
# NOTIFY_PORT=0 — приёмник выключен.
NOTIFY_PORT=0

# Адрес интерфейса приёмника (0.0.0.0 — все интерфейсы)
NOTIFY_HOST=0.0.0.0

# Секретная строка авторизации. ОБЯЗАТЕЛЬНО задайте, если NOTIFY_PORT != 0,
# иначе любой в сети сможет слать сообщения от имени бота.
NOTIFY_TOKEN=

# --- Расширенные настройки (обычно не требуется менять) ----------------------

# Таймаут HTTP-запросов к Home Assistant, секунды
# HA_TIMEOUT=15

# Интервал обновления списка устройств из Home Assistant, секунды (минимум 15).
# Увеличьте (например, до 300) для серверов с малым объёмом RAM.
# REFRESH_INTERVAL=60

# Папка для данных (языки пользователей, таймеры).
# По умолчанию: ./data рядом с bot.py; в Docker — /app/data.
# DATA_DIR=./data
