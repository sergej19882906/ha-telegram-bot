# Telegram Bot Token (получить у @BotFather)
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# Home Assistant URL (локальный адрес вашего HA)
HA_BASE_URL=http://192.168.1.50:8123

# Home Assistant Long-Lived Access Token
# Получить: Профиль → Long-Lived Access Tokens → Create Token
HA_ACCESS_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Ваш Telegram User ID (для ограничения доступа)
# Узнать: написать @userinfobot в Telegram
ALLOWED_USER_ID=123456789

# Язык по умолчанию: ru или en
DEFAULT_LANG=ru