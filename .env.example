# =============================================================================
# HA Telegram Bot — пример конфигурации (.env)
# Скопируйте этот файл в .env и заполните значения:
#   Linux:  cp .env.example .env
#   Windows: copy .env.example .env
# =============================================================================

# --- Telegram ----------------------------------------------------------------
# Токен бота от @BotFather (обязательно)
TELEGRAM_BOT_TOKEN=

# --- Home Assistant ----------------------------------------------------------
# Адрес вашего Home Assistant (обязательно)
HA_BASE_URL=http://localhost:8123

# Long-Lived Access Token (Профиль -> Long-Lived Access Tokens) (обязательно)
HA_ACCESS_TOKEN=

# --- Доступ ------------------------------------------------------------------
# Разрешённые пользователи — Telegram ID через запятую.
# Узнать свой ID: напишите @userinfobot в Telegram.
# БОТ НЕ СТАРТУЕТ, если список пуст! Открытый доступ возможен только при
# явно заданной переменной ALLOW_ALL_USERS=1 (не рекомендуется).
ALLOWED_USER_IDS=

# Открыть доступ к боту ВСЕМ (1 = да). Используйте только если понимаете риск:
# любой, кто найдёт вашего бота в Telegram, сможет управлять домом.
# Без ALLOWED_USER_IDS и без ALLOW_ALL_USERS=1 бот завершит запуск с ошибкой.
#ALLOW_ALL_USERS=0

# Язык по умолчанию для новых пользователей: ru или en
DEFAULT_LANG=ru

# --- Приёмник уведомлений из Home Assistant (опционально) --------------------
# Бот поднимет HTTP-endpoint, куда HA может присылать сообщения через
# rest_command (см. README.md -> "Уведомления из Home Assistant").
# NOTIFY_PORT=0 — приёмник выключен.
NOTIFY_PORT=0

# Адрес интерфейса приёмника (0.0.0.0 — все интерфейсы)
NOTIFY_HOST=0.0.0.0

# Секретная строка авторизации. ОБЯЗАТЕЛЬНО задайте, если NOTIFY_PORT != 0,
# иначе любой в сети сможет слать сообщения от имени бота.
NOTIFY_TOKEN=

# --- Сторож уведомлений (опционально) ----------------------------------------
# Периодическая проверка цепочки HA -> бот -> Telegram: бот шлёт тестовое
# сообщение через указанный rest_command в HA и ждёт его возврата на свой
# приёмник. При поломке/восстановлении приходит алерт всем адресатам уведомлений.
# Интервал в секундах (минимум 60, 0 = выключено).
#NOTIFY_WATCHDOG_INTERVAL=0
# Имя rest_command для проверки (как в configuration.yaml HA).
#NOTIFY_WATCHDOG_COMMAND=

# --- Расширенные настройки (обычно не требуется менять) ----------------------

# Таймаут HTTP-запросов к Home Assistant, секунды
# HA_TIMEOUT=15

# Папка для данных (языки пользователей, таймеры).
# По умолчанию: ./data рядом с bot.py; в Docker — /app/data.
# DATA_DIR=./data

# Интервал обновления реестра устройств из HA, секунды (минимум 15).
# По умолчанию 60. Для серверов с малым объёмом RAM поставьте 300.
# REFRESH_INTERVAL=60
