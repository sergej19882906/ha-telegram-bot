# --- Секреты (НЕ попадают в образ и build-контекст) ---
.env
.env.*
!.env.example

# --- Git ---
.git
.gitignore

# --- Виртуальное окружение и Python ---
venv/
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# --- Логи и данные (в контейнере создаются свои) ---
logs/
data/
*.log

# --- IDE / ОС ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- Скрипты и документация (в образ не копируются) ---
*.bat
*.sh
*.md
